@echo off
@rem @NAME@ launcher generated by the emuStudio build. JVM options: JAVA_OPTS, @OPTS@.
setlocal

set APP_HOME=%~dp0..
for %%i in ("%APP_HOME%") do set APP_HOME=%%~fi

set JAVA_EXE=java.exe
if defined JAVA_HOME set JAVA_EXE=%JAVA_HOME%\bin\java.exe

"%JAVA_EXE%" %JAVA_OPTS% %@OPTS@% -classpath "@CLASSPATH_BAT@" @MAIN_CLASS@ %*
exit /b %ERRORLEVEL%
