; The UK schools winner of the 1998 SSEM Programming Competition.
;
; An implementation of "division by repeated subtraction".
;
; Written by: 	Brendan Campbell
; Obtained from: 	The 1998 SSEM Programming Competition.
; Description: 	Integer division, giving quotient and remainder.
; Parameter Lines: 	28: Dividend
;                   29: Divisor
; Result Lines: 	30: Quotient
;                   31: Remainder

00 BNUM 00000000000000000000011110000000  ; Unused bootstrap/data word; execution begins at line 01.
01 LDN 29                                 ; ACC = -divisor.
02 STO 27                                 ; Store -divisor in scratch line 27.
03 LDN 28                                 ; ACC = -dividend.
04 STO 26                                 ; Store -dividend in scratch line 26.
05 LDN 26                                 ; ACC = dividend.
06 SUB 29                                 ; ACC = dividend - divisor.
07 STO 28                                 ; Update dividend/remainder candidate.
08 CMP                                    ; If result is negative, skip the next line.
09 JMP 25                                 ; Non-negative: branch via the jump target encoded in line 25 to the finish block.
10 SUB 27                                 ; Negative case: ACC = (dividend - divisor) - (-divisor) = current remainder.
11 STO 31                                 ; Store remainder.
12 STP                                    ; Halt: quotient is in line 30, remainder in line 31.
13 LDN 30                                 ; ACC = -quotient.
14 SUB 24                                 ; ACC = -quotient - 1.
15 STO 30                                 ; Store the intermediate negative quotient.
16 LDN 30                                 ; ACC = quotient + 1.
17 STO 30                                 ; Store the updated positive quotient.
18 JMP 23                                 ; Branch via the jump target encoded in line 23 to continue the division loop.
19 BNUM 00000000000000000000010000000000  ; Spare constant/data word.
20 BNUM 00000000000000000000010000000000  ; Spare constant/data word.
21 BNUM 00000000000000000000010000000000  ; Spare constant/data word.
22 BNUM 00000000000000000000001111000000  ; Spare constant/data word.
23 BNUM 01000000000000000000000000000000  ; Encoded jump target used by line 18 to loop for another subtraction step.
24 BNUM 10000000000000000000000000000000  ; Constant 1, used to increment the quotient.
25 BNUM 00110000000000000000000000000000  ; Encoded jump target used by line 09 to branch to the finish block.
26 BNUM 00000000000000000000000000000000  ; Scratch: holds -dividend.
27 BNUM 00000000000000000000000000000000  ; Scratch: holds -divisor.
28 BNUM 01011001010000000000000000000000  ; Input dividend = 666.
29 BNUM 01010100000000000000000000000000  ; Input divisor = 42.
30 BNUM 00000000000000000000000000000000  ; Output quotient (written during the loop).
31 BNUM 00000000000000000000000000000000  ; Output remainder.
