; (The "dog kennel" on the right hand side of the code is the University of Manchester logo.)
;
; Written by: 	John Deane of Australia.
; Obtained from: 	The 1998 SSEM Programming Competition.
; Description: 	"Mediaeval analog clock which displays the hour as the number of zeroes counted from the left in location 30.
;               The fraction of the hour is displayed in location 31 where each 0 from the left indicates 1/32 hour (about 2 minutes)."
; Parameter Lines: 	27: initial value for the timing interval counter. See code below.
; Result Lines: 	30: hours display
;                   31: 1/32 hour display
; (run time display)

01 LDN 27                                 ; ACC = -timingCounterStart.
02 SUB 28                                 ; ACC = ACC - 1: start a countdown delay loop.
03 CMP                                    ; If the countdown went negative, skip the next line.
04 JMP 28                                 ; Otherwise branch via line 28 back to line 02 and keep counting down.
05 LDN 31                                 ; ACC = -fractionDisplay.
06 STO 0                                  ; Save -fractionDisplay in scratch line 0.
07 LDN 0                                  ; ACC = fractionDisplay.
08 SUB 0                                  ; ACC = fractionDisplay - (-fractionDisplay) = 2 * fractionDisplay.
09 STO 31                                 ; Update the 1/32-hour display by shifting its bit pattern.
10 CMP                                    ; If the fractional display overflowed into non-negative, skip the next line.
11 JPR 28                                 ; Overflow case: skip line 12 and continue to the hours update at line 13.
12 JMP 29                                 ; No overflow yet: branch via line 29 back to line 01 for the next timed tick.
13 LDN 28                                 ; ACC = -1.
14 STO 31                                 ; Reset the fractional display to all ones for the next hour.
15 LDN 30                                 ; ACC = -hoursDisplay.
16 STO 0                                  ; Save -hoursDisplay in scratch line 0.
17 LDN 0                                  ; ACC = hoursDisplay.
18 SUB 0                                  ; ACC = hoursDisplay - (-hoursDisplay) = 2 * hoursDisplay.
19 STO 30                                 ; Advance the hour display by shifting its bit pattern.
20 SUB 26                                 ; Add 2048 effectively, to test whether the hour display has wrapped.
21 CMP                                    ; If still negative, skip the next line and reset the hours display.
22 JMP 29                                 ; Normal case: branch via line 29 back to line 01.
23 LDN 28                                 ; ACC = -1.
24 STO 30                                 ; Reset the hour display to all ones after wraparound.
25 JMP 29                                 ; Branch via line 29 back to line 01.
26 BNUM 00000000000111111111111111111111  ; Constant -2048, used as the hour-display wrap threshold.
; Choose one timing constant for line 27.
;27 BNUM 01101110100110011111111111111111 ; Original machine timing counter = -26250.
27 BNUM 10111111111111111111111111111111  ; Faster simulation timing counter = -3.
28 BNUM 10000000000000000000000000000000  ; Constant 1, used for countdown and branch offsets/targets.
29 BNUM 00000000000000000000000000000000  ; Constant 0, used by JMP to restart execution at line 01.
30 BNUM 11111111111111111111111111111111  ; Hours display state, initially all ones.
31 BNUM 11111111111111111111111111111111  ; Fraction-of-hour display state, initially all ones.
